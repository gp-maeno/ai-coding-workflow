{
  "name": "visual-diff-loop",
  "version": "0.1.0",
  "private": true,
  "description": "Figma → Claude Code のデザイン再現率を上げるためのビジュアル差分ループ",
  "scripts": {
    "fetch-figma": "node scripts/fetch-figma.js",
    "render": "node scripts/render.js",
    "diff": "node scripts/visual-diff.js",
    "serve": "npx serve src -p 3000",
    "all": "npm run fetch-figma && npm run render && npm run diff"
  },
  "dependencies": {
    "pixelmatch": "^5.3.0",
    "playwright": "^1.45.0",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "serve": "^14.2.0"
  }
}
